[Unit]
Description=Turing USB display system monitor
After=local-fs.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/libexec/turing-screen-monitor --device auto --interval 2
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
